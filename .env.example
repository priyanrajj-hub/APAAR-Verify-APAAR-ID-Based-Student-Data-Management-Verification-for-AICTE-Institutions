# Environment Configuration for APAAR-Verify

# Web Frontend (Vercel / Local)
NEXT_PUBLIC_APP_NAME="APAAR-Verify"
NEXT_PUBLIC_API_URL="http://localhost:8000"
NEXT_PUBLIC_ENABLE_DEMO_MODE=true

# API Gateway & Backend Microservices
PORT=8000
REDIS_URL="redis://localhost:6379/0"
QDRANT_URL="http://localhost:6333"

# Firebase (Emulators for local dev)
FIREBASE_AUTH_EMULATOR_HOST="localhost:9099"
FIRESTORE_EMULATOR_HOST="localhost:8080"
FIREBASE_STORAGE_EMULATOR_HOST="localhost:9199"
GCLOUD_PROJECT="apaar-verify-sih"

# LLM Providers (agnostic provider selection with offline fallback)
LLM_PROVIDER="offline" # or "gemini", "claude"
GEMINI_API_KEY=""
CLAUDE_API_KEY=""
