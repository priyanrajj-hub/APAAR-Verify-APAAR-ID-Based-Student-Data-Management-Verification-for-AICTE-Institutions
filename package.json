{
  "name": "apaar-verify-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "APAAR-Verify: APAAR ID-Based Student Data Management & Verification for AICTE Institutions (SIH 2026, Idea ID 225558)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "npm run dev --workspace=apps/web",
    "build": "npm run build --workspaces --if-present",
    "vercel-build": "npm run build --workspace=apps/web",
    "test": "node scripts/check-i18n.js && npm run test --workspace=apps/web && python -m pytest tests/",
    "test:e2e": "playwright test",
    "test:cov": "python -m pytest tests/ --cov=services --cov=ml --cov-report=term-missing",
    "benchmark": "node scripts/benchmark.js",
    "check-i18n": "node scripts/check-i18n.js",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "typescript": "^5.7.3"
  }
}
