{
  "compilerOptions": {
    "target": "ES2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@apaar/shared-types": ["../shared-types/src"],
      "@apaar/i18n": ["../i18n/src"]
    }
  },
  "include": ["src/**/*"]
}
